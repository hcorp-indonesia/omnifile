# Required external services
DATABASE_URL=postgres://magic_converter:replace_me@postgres.example.internal:5432/magic_converter?sslmode=require
DRAGONFLY_ADDR=dragonfly.example.internal:6379
DRAGONFLY_USERNAME=
DRAGONFLY_PASSWORD=replace_me
DRAGONFLY_DB=0

# Required application secrets
JWT_SECRET=replace_with_at_least_32_random_characters
OTP_SECRET=replace_with_another_random_secret
FRONTEND_URL=https://converter.example.com
CORS_ALLOW_ORIGINS=https://converter.example.com

# Required for passwordless email login
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=replace_me
SMTP_FROM=Magic Converter <noreply@example.com>

# Optional external services
PDFCO_API_KEY=
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=magic-converter
RUSTFS_ENDPOINT=https://s3.example.com
RUSTFS_USE_PATH_STYLE=true

# Runtime tuning
RUN_MIGRATIONS=true
SERVER_READ_TIMEOUT=120
REMBG_CPU_THREADS=4
