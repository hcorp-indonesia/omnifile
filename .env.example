APP_ENV=development

DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=magic_converter
DB_SSL_MODE=disable

FIBER_PREFORK=false
APP_PORT=8000
APP_HOST=127.0.0.1

SERVER_READ_TIMEOUT=10

CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_HEADERS=Origin, Content-Type, Accept, Authorization
CORS_ALLOW_METHODS=GET,POST,DELETE,OPTIONS,PUT,PATCH
CORS_EXPOSE_HEADERS=X-Remove-Bg-Original-Format,X-Remove-Bg-Converted-Format,X-Remove-Bg-Original-Size,X-Remove-Bg-Result-Size,X-Remove-Bg-Original-Width,X-Remove-Bg-Original-Height,X-Remove-Bg-Width,X-Remove-Bg-Height,X-Remove-Bg-Model

JWT_SECRET=your_jwt_secret_key_change_me

LOG_LEVEL=debug

DRAGONFLY_ADDR=localhost:6379
DRAGONFLY_PASSWORD=
DRAGONFLY_DB=0
DRAGONFLY_KEY_PREFIX=magic_converter

RUSTFS_ACCESS_KEY_ID=access_key
RUSTFS_SECRET_ACCESS_KEY=secret_key
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=magic-converter
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_USE_PATH_STYLE=false

PDFCO_API_KEY=your_pdfco_api_key_here

TESSERACT_PATH=tesseract
TESSERACT_LANG=eng+ind

# Download RealESRGAN_x4plus.pth and point this variable to it.
REALESRGAN_MODEL_PATH=./models/RealESRGAN_x4plus.pth
# Fast GPU path. Use "python" to force the high-quality CPU worker.
REALESRGAN_ENGINE=auto
REALESRGAN_NCNN_PATH=./tools/realesrgan-ncnn-vulkan/realesrgan-ncnn-vulkan.exe
REALESRGAN_NCNN_MODELS_PATH=./tools/realesrgan-ncnn-vulkan/models
REALESRGAN_NCNN_MODEL=realesr-animevideov3

# BiRefNet General Lite background removal.
REMBG_MODEL_DIR=./models/rembg
REMBG_PYTHON_PATH=./.venv/Scripts/python.exe
REMBG_PROVIDER=cpu
REMBG_CPU_THREADS=8
